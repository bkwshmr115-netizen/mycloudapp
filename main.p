import os
import sys
import time

def clear_screen():
    os.system('clear')

def print_menu():
    clear_screen()
    print("\033[1;32m====================================")
    print("      ★ تطبيقي المبتكر للحماية ★     ")
    print("====================================\033[0m")
    print("[1] 🛡️ تفعيل الدرع الرقمي والفحص")
    print("[2] 🔑 تشفير النصوص والرسائل الفائقة")
    print("[3] ❌ خروج من البرنامج")
    print("\033[1;32m====================================\033[0m")

while True:
    print_menu()
    choice = input("\033[1;36mاختر رقماً لتنفيذ الأمر: \033[0m")
    
    if choice == '1':
        print("\n\033[1;33mجاري جلب جدار الحماية وفحص النظام...\033[0m")
        time.sleep(2)
        print("\033[1;32m✓ تم تفعيل الدرع الرقمي بنجاح 100%!\033[0m")
        input("\nاضغط Enter للعودة للقائمة...")
    elif choice == '2':
        text = input("\nأدخل النص السري لتشفيره: ")
        print("\033[1;35mجاري التشفير بنظام عسكري فائق...\033[0m")
        time.sleep(1.5)
        print(f"\033[1;32mالنص المشفر التابع لك: [ENC-{text[::-1]}-99X]\033[0m")
        input("\nاضغط Enter للعودة للقائمة...")
    elif choice == '3':
        print("\nشكراً لاستخدام تطبيقك المبتكر. وداعاً!")
        sys.exit()
    else:
        print("\033[1;31mاختيار خاطئ! الرجاء إدخال 1 أو 2 أو 3\033[0m")
        time.sleep(1.5)
